# TheRain Unified environment template.
# Copy to .env only for a local or deployed installation. Never commit .env.
# The legacy Pharmacy POS continues to use config/db.php until its verified
# compatibility migration; this template is consumed by core/config/bootstrap.php.

APP_NAME="TheRain Unified"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Africa/Douala
APP_PASSWORD_MIN_LENGTH=8
APP_MAX_ACTIVE_SESSIONS=3
APP_SESSION_LIFETIME_MINUTES=120

DB_CONNECTION=mysqli
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=therain_unified
DB_USERNAME=change_me
DB_PASSWORD=change_me
DB_CHARSET=utf8mb4
