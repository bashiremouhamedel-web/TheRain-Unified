# Environment and secrets
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/

# Local configuration overrides
config/db.local.php
config/local.php
core/config/local.php

# Runtime data (directory placeholders remain tracked)
storage/uploads/*
!storage/uploads/.gitkeep
!storage/uploads/.htaccess
storage/logs/*
!storage/logs/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
storage/backups/*
!storage/backups/.gitkeep
storage/invoices/*
!storage/invoices/.gitkeep
storage/receipts/*
!storage/receipts/.gitkeep
storage/tmp/*
!storage/tmp/.gitkeep

# Local database dumps and backups
*.sqlite
*.sqlite3
*.bak
*.backup
database/*.local.sql
database/*.dump.sql

# Dependencies and build artefacts
vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors and operating systems
.idea/
.vscode/
.claude/
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini
